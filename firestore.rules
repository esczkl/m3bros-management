rules_version = '2';

// Role-based access for M3 Bros Management System.
// Roles live in users/{uid}.role: 'admin' | 'manager' | 'owner'.
// These mirror the app's permission flags in src/hooks/useAuth.js:
//   canManage        = admin, manager          -> transactions, inventory, attendance
//   canManageStaff   = admin, manager, owner   -> staff, services
//   isAdmin          = admin                   -> users
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Fails closed: if the user has no profile document, get() errors and access is denied.
    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin()          { return signedIn() && role() == 'admin'; }
    function canManage()        { return signedIn() && role() in ['admin', 'manager']; }
    function canManageCatalog() { return signedIn() && role() in ['admin', 'manager', 'owner']; }

    match /users/{uid} {
      allow read: if signedIn();
      // First login auto-creates the user's own profile as 'manager' (see useAuth.js).
      // Login accounts can only be created in the Firebase Console, so this does not open sign-ups.
      allow create: if isAdmin()
        || (signedIn() && request.auth.uid == uid && request.resource.data.role == 'manager');
      // Only admins can change roles or remove users; nobody can promote themselves.
      allow update, delete: if isAdmin();
    }

    match /transactions/{id} {
      allow read: if signedIn();
      allow write: if canManage();
    }

    match /inventory/{id} {
      allow read: if signedIn();
      allow write: if canManage();
    }

    match /inventoryLogs/{id} {
      allow read: if signedIn();
      allow write: if canManage();
    }

    match /attendance/{id} {
      allow read: if signedIn();
      allow write: if canManage();
    }

    match /staff/{id} {
      allow read: if signedIn();
      allow write: if canManageCatalog();
    }

    match /services/{id} {
      allow read: if signedIn();
      allow write: if canManageCatalog();
    }

    // Anything not listed above is denied by default.
  }
}
